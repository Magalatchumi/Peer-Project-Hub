# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/peer-project-hub

# Frontend URL (for CORS)
FRONTEND_URL=https://peer-project-hub-git-main-magalatchumis-projects.vercel.app,http://localhost:5173

# Firebase Admin SDK Configuration
# Option 1: Path to service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual Firebase Admin credentials (preferred on Render)
# Expected Firebase project for Admin credentials
FIREBASE_EXPECTED_PROJECT_ID=peer-project-hub-2549b

# Option 2: Individual Firebase Admin credentials (preferred on Render)
# These must come from the same Firebase project as the frontend: peer-project-hub-2549b
# FIREBASE_PROJECT_ID=peer-project-hub-2549b
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@peer-project-hub-2549b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
