# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/peer-project-hub

# Frontend URL (for CORS)
FRONTEND_URL=https://peer-project-hub-git-main-magalatchumis-projects.vercel.app,http://localhost:5173

# Firebase Admin SDK Configuration
# Option 1: Path to service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual Firebase Admin config values (used if no service account path)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
